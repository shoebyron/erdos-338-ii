def Erdos338.HasOrder : Set ℕ → ℕ → Prop :=
fun A h ↦ ∀ᶠ (m : ℕ) in Filter.atTop, ∃ S, (∀ x ∈ S, x ∈ A) ∧ S.card ≤ h ∧ S.sum = m
def Erdos338.HasRestrictedOrder : Set ℕ → ℕ → Prop :=
fun A t ↦ ∀ᶠ (m : ℕ) in Filter.atTop, ∃ S, (∀ x ∈ S, x ∈ A) ∧ S.card ≤ t ∧ ∑ x ∈ S, x = m
Erdos338.audit_bounded_by_order : ∃ f,
  ∀ (A : Set ℕ) (h : ℕ),
    Erdos338.HasOrder A h → (∃ t, Erdos338.HasRestrictedOrder A t) → Erdos338.HasRestrictedOrder A (f h)
'Erdos338.audit_bounded_by_order' depends on axioms: [propext, Classical.choice, Quot.sound]
