def Erdos338.Bridge.BoundedByOrder : Prop :=
∃ f,
  ∀ (A : Set ℕ) (h : ℕ),
    Erdos338.Bridge.HasOrder A h →
      (∃ t, Erdos338.Bridge.HasRestrictedOrder A t) → Erdos338.Bridge.HasRestrictedOrder A (f h)
def Erdos338.Bridge.HasOrder : Set ℕ → ℕ → Prop :=
fun A h ↦ ∀ᶠ (n : ℕ) in Filter.atTop, ∃ s, (∀ x ∈ s, x ∈ A) ∧ s.card ≤ h ∧ s.sum = n
def Erdos338.Bridge.HasRestrictedOrder : Set ℕ → ℕ → Prop :=
fun A t ↦ ∀ᶠ (n : ℕ) in Filter.atTop, Erdos338.Bridge.Rep A t n
def Erdos338.Bridge.Rep : Set ℕ → ℕ → ℕ → Prop :=
fun A h n ↦ ∃ s, (∀ x ∈ s, x ∈ A) ∧ s.card ≤ h ∧ s.sum id = n
